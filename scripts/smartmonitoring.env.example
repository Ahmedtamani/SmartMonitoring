# Copie ce fichier vers /etc/smartmonitoring.env puis adapte les valeurs.

# MQTT (université)
MQTT_BROKER=mqtt.univ-cotedazur.fr
MQTT_PORT=443
MQTT_USER=CHANGE_ME
MQTT_PASS=CHANGE_ME
MQTT_TOPIC=FABLAB_21_22/#

# API MQTT
TOPIC_REQUETE=FABLAB_21_22/WEB/REQUETE
TOPIC_REPONSE=FABLAB_21_22/WEB/REPONSE

# MySQL
DB_HOST=127.0.0.1
DB_USER=fablab_user
DB_PASS=CHANGE_ME
DB_NAME=fablab_monitoring

# Fréquence d'écriture bridge (secondes)
SAVE_INTERVAL_SECONDS=60
