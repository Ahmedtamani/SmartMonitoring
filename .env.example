# Copie vers .env puis remplace les valeurs sensibles.

# Docker / MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=fablab_monitoring
MYSQL_USER=fablab_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Bridge / API
DB_HOST=127.0.0.1
DB_USER=fablab_user
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=fablab_monitoring

# MQTT (université)
MQTT_BROKER=mqtt.univ-cotedazur.fr
MQTT_PORT=443
MQTT_USER=CHANGE_ME_MQTT_USER
MQTT_PASS=CHANGE_ME_MQTT_PASS
MQTT_TOPIC=FABLAB_21_22/#

# API topics
TOPIC_REQUETE=FABLAB_21_22/WEB/REQUETE
TOPIC_REPONSE=FABLAB_21_22/WEB/REPONSE

# Admin web (compte unique)
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD
ADMIN_TOKEN_TTL_MS=28800000
